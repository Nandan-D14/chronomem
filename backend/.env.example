# FalkorDB (local Docker defaults; for FalkorDB Cloud paste host/port/user/password)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=

# Default memory graph the MCP server writes to (mem_<user>)
CHRONOMEM_USER=default

# Optional: enables the built-in chat agent in the dashboard.
# Any OpenAI-compatible provider works (OpenAI, Groq, Gemini, Ollama...).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

CORS_ORIGINS=*
